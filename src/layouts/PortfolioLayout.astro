---
import Header from '../components/Header.astro';
import HeroOverview from '../components/HeroOverview.astro';
import FlagshipProjectsOverview from '../components/FlagshipProjectsOverview.astro';
import CleanArchitectureDiagram from '../components/CleanArchitectureDiagram.astro';
import FlagshipDeepDives from '../components/FlagshipDeepDives.astro';
import SkillsAndTimeline from '../components/SkillsAndTimeline.astro';
import SystemDeepDives from '../components/SystemDeepDives.astro';
import ResumeModal from '../components/ResumeModal.astro';
import ContactModal from '../components/ContactModal.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  initialTab?: string;
  currentSlug?: string;
}

const { initialTab = 'overview-tab', currentSlug = '' } = Astro.props;

const siteUrl = "https://filelucker.github.io";

const titlesByTab: Record<string, string> = {
  'overview-tab': 'Md Moniruzzaman | Senior Mobile Engineer & Systems Architect | Mobile AI Engineer & POS Specialist',
  'flagship-tab': 'Flagship Projects & Production Architectures | Md Moniruzzaman',
  'skills-tab': 'Skills Matrix, Open Source & Career Timeline | Md Moniruzzaman',
  'playbook-tab': 'System Architecture Playbook & Benchmarks | Md Moniruzzaman'
};

const descriptionsByTab: Record<string, string> = {
  'overview-tab': 'Portfolio & System Architecture Playbook of Md Moniruzzaman. Senior Mobile Engineer, Mobile AI Engineer & Systems Architect specializing in on-device inference (LiteRT, ONNX, CoreML), Point of Sale (POS) hardware fleets, and high-concurrency fintech platforms serving 50M+ users.',
  'flagship-tab': 'Flagship production mobile architectures by Md Moniruzzaman: DGePay (10K+ POS terminals), Sarkari Kroy Dorpon (CPTU e-GP), UNICEF Adolescent Health, and praniSheba IoT.',
  'skills-tab': 'Technical skills matrix, open-source packages, verified certifications (PCI-DSS, Claude AI, CCNA), and 7+ years engineering timeline of Md Moniruzzaman.',
  'playbook-tab': 'System Architecture Playbook: Architectural Decision Records (ADRs), system latency benchmarks, hardware abstraction layers, and offline-first SQLite WAL patterns.'
};

const pageTitle = titlesByTab[initialTab] || titlesByTab['overview-tab'];
const description = descriptionsByTab[initialTab] || descriptionsByTab['overview-tab'];

const slugPath = currentSlug ? `/${currentSlug}` : '';
const canonicalUrl = `${siteUrl}${slugPath}`;
const ogImageUrl = `${siteUrl}/og-image.png`;
const profileImageUrl = `${siteUrl}/profile.jpg`;

// JSON-LD Structured Data Schema
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      "name": "Md Moniruzzaman",
      "alternateName": "filelucker",
      "url": siteUrl,
      "image": profileImageUrl,
      "jobTitle": "Senior Mobile Engineer & Systems Architect",
      "worksFor": {
        "@type": "Organization",
        "name": "DG INFOTECH LTD (DGePay, Concern of Dipon Group)"
      },
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "Daffodil International University"
        },
        {
          "@type": "CollegeOrUniversity",
          "name": "Bogura Polytechnic Institute"
        }
      ],
      "sameAs": [
        "https://github.com/filelucker",
        "https://www.linkedin.com/in/mon000"
      ],
      "knowsAbout": [
        "Mobile Systems Architecture",
        "Android Development (Kotlin, Java, NDK)",
        "iOS Development (Swift, SwiftUI)",
        "Cross-Platform (Flutter, Dart)",
        "On-Device AI Inference (LiteRT, ONNX, CoreML)",
        "Point of Sale (POS) Hardware Fleets & ESC/POS",
        "PCI-DSS v4.0.1 FinTech Compliance",
        "Offline-First Architecture & SQLite WAL",
        "High-Concurrency Payment Systems"
      ],
      "award": "Awarded by Bogura DC Office (Govt. of Bangladesh) for Mobile App Development (2015)"
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Md Moniruzzaman Portfolio & System Playbook",
      "description": description,
      "publisher": {
        "@id": `${siteUrl}/#person`
      }
    },
    {
      "@type": "ProfilePage",
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": pageTitle,
      "isPartOf": {
        "@id": `${siteUrl}/#website`
      },
      "mainEntity": {
        "@id": `${siteUrl}/#person`
      },
      "description": description
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#090d16" />

    <!-- Crawlers & Robots -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />

    <!-- Author & Entity Metadata -->
    <meta name="author" content="Md Moniruzzaman" />
    <meta name="creator" content="Md Moniruzzaman" />
    <meta name="publisher" content="Md Moniruzzaman" />
    <meta name="keywords" content="Md Moniruzzaman, Senior Mobile Engineer, Mobile AI Engineer, Systems Architect, Android Architect, Flutter Specialist, Point of Sale POS, PCI-DSS, Offline-First Architecture, LiteRT, ONNX, High Concurrency, Bangladesh Software Engineer" />
    <meta name="geo.region" content="BD" />
    <meta name="geo.placename" content="Dhaka" />

    <!-- OpenGraph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Md Moniruzzaman Portfolio" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Md Moniruzzaman - Senior Mobile Engineer & Systems Architect" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Md Moniruzzaman - Senior Mobile Engineer & Systems Architect" />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google Analytics (GA4) -->
    <GoogleAnalytics />

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Theme Initialization Script to prevent flicker -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('color-theme')) {
          return localStorage.getItem('color-theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="min-h-screen flex flex-col cyber-grid relative selection:bg-emerald-500 selection:text-white">

    <!-- Top Navigation Header -->
    <Header activeTab={initialTab} />

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-4 space-y-4">
      
      <!-- Tab 01: Overview & Architecture Viewport -->
      <div id="overview-tab" class={`tab-content space-y-4 ${initialTab === 'overview-tab' ? '' : 'hidden'}`}>
        <HeroOverview />
        <FlagshipProjectsOverview />
        <CleanArchitectureDiagram />
      </div>

      <!-- Tab 02: Flagship Production Projects Deep Dive -->
      <div id="flagship-tab" class={`tab-content ${initialTab === 'flagship-tab' ? '' : 'hidden'}`}>
        <FlagshipDeepDives />
      </div>

      <!-- Tab 03: Skills Matrix, Open Source & Leadership Timeline -->
      <div id="skills-tab" class={`tab-content ${initialTab === 'skills-tab' ? '' : 'hidden'}`}>
        <SkillsAndTimeline />
      </div>

      <!-- Tab 04: System Deep Dives & Playbook -->
      <div id="playbook-tab" class={`tab-content ${initialTab === 'playbook-tab' ? '' : 'hidden'}`}>
        <SystemDeepDives />
      </div>

    </main>

    <!-- Modals -->
    <ResumeModal />
    <ContactModal />

    <!-- Footer Component -->
    <Footer />

  </body>
</html>
