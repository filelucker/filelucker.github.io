---
import { FLAGSHIP_PROJECTS } from '../data/portfolioData';
---

<section class="py-6 border-b border-[var(--border-color)]">
  
  <div class="mb-4">
    <div class="flex items-center space-x-2 text-xs font-mono text-cyan-500 font-bold mb-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
      <span>BATTLE-HARDENED SYSTEMS ENGINEERED AT SCALE</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)] tracking-tight font-mono">
      FLAGSHIP PRODUCTION PLATFORMS
    </h2>
    <p class="text-sm text-[var(--text-muted)] mt-1 font-mono">
      High-concurrency, mission-critical systems deployed across digital financial services, high-throughput merchant aggregators, and national infrastructure.
    </p>
  </div>

  <!-- 4 Card Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {FLAGSHIP_PROJECTS.map((project) => (
      <div class="terminal-card p-6 flex flex-col justify-between group relative overflow-hidden">
        
        <!-- Top Glow Accent -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-cyan-500 opacity-40 group-hover:opacity-100 transition-opacity"></div>

        <div>
          <!-- Header Category & Badge -->
          <div class="flex items-center justify-between mb-3 font-mono text-xs">
            <span class="text-emerald-500 font-semibold uppercase tracking-wider">{project.category}</span>
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold">
              {project.badgeText}
            </span>
          </div>

          <!-- Project Title -->
          <h3 class="text-xl font-bold text-[var(--text-primary)] group-hover:text-cyan-400 transition-colors font-mono mb-2">
            {project.title}
          </h3>

          <!-- Short Description -->
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
            {project.description}
          </p>

          <!-- Impact Metrics 2x2 Grid inside Card -->
          <div class="grid grid-cols-2 gap-2 my-4 p-3 rounded-lg bg-[var(--bg-main)] border border-[var(--border-color)] font-mono text-xs">
            {project.impactMetrics.map((metric) => (
              <div>
                <span class="text-[10px] text-[var(--text-muted)] block uppercase">{metric.label}</span>
                <span class="font-bold text-[var(--text-primary)] text-sm">{metric.value}</span>
              </div>
            ))}
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5 mb-4 font-mono text-[11px]">
            {project.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded bg-[var(--bg-card-hover)] border border-[var(--border-color)] text-[var(--text-muted)]">
                #{tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Deep Dive Action Link & Store Links -->
        <div class="pt-4 border-t border-[var(--border-color)] flex flex-wrap items-center justify-between gap-2 font-mono text-xs">
          <button 
            data-open-project={project.id}
            class="text-emerald-500 font-bold hover:text-emerald-400 flex items-center space-x-1 cursor-pointer transition-colors"
          >
            <span>VIEW ARCHITECTURE</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </button>

          {project.appLinks && project.appLinks.length > 0 && (
            <div class="flex items-center gap-1.5">
              {project.appLinks.map((app) => (
                <a 
                  href={app.url} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  title={app.label}
                  class="p-1.5 rounded-md bg-[var(--bg-main)] text-[var(--text-secondary)] hover:text-emerald-400 hover:bg-[var(--bg-card-hover)] border border-[var(--border-color)] hover:border-emerald-500 transition-colors inline-flex items-center justify-center"
                >
                  {app.type === 'playstore' && (
                    <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M3.609 1.814L13.792 12 3.61 22.186a2.008 2.008 0 0 1-.61-1.42V3.234c0-.54.225-1.047.61-1.42zM15.207 13.414l2.586 2.586-11.517 6.65 8.931-9.236zm0-2.828L6.276 1.35l11.517 6.65-2.586 2.586zm1.414 1.414l3.535 2.042c1.125.65 1.125 1.71 0 2.36l-3.535 2.041-2.122-2.121 2.122-2.322z"/>
                    </svg>
                  )}
                  {app.type === 'appstore' && (
                    <svg class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 0.92-2.87-.93.04-2.03.63-2.67 1.38-.56.65-.99 1.7-0.86 2.73 1.05.08 2-.49 2.61-1.24z"/>
                    </svg>
                  )}
                  {app.type === 'website' && (
                    <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                    </svg>
                  )}
                  {app.type === 'github' && (
                    <svg class="w-3.5 h-3.5 text-purple-400" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                    </svg>
                  )}
                  {app.type === 'apk' && (
                    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                  )}
                  {app.type === 'drive' && (
                    <svg class="w-3.5 h-3.5 text-amber-400" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M7.71 3.5L1.15 15l3.43 6 6.55-11.5L7.71 3.5zm3.72 6.5l3.43 6h7.99l-3.43-6h-7.99zm5.42-6.5l-3.43 6 4 6.99 6.55-11.5-7.12-.49z"/>
                    </svg>
                  )}
                </a>
              ))}
            </div>
          )}
        </div>

      </div>
    ))}
  </div>

</section>

<script>
  // Link project cards to Flagship Deep Dive tab
  const projectBtns = document.querySelectorAll('[data-open-project]');
  projectBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const flagshipTabBtn = document.querySelector('[data-tab-target="flagship-tab"]');
      if (flagshipTabBtn instanceof HTMLElement) {
        flagshipTabBtn.click();
      }
    });
  });
</script>
