---
import { FLAGSHIP_PROJECTS } from '../data/portfolioData';
---

<section class="py-6 border-b border-[var(--border-color)]">
  
  <div class="mb-4">
    <div class="flex items-center space-x-2 text-xs font-mono text-cyan-500 font-bold mb-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
      <span>BATTLE-HARDENED SYSTEMS ENGINEERED AT SCALE</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)] tracking-tight font-mono">
      FLAGSHIP PRODUCTION PLATFORMS
    </h2>
    <p class="text-sm text-[var(--text-muted)] mt-1 font-mono">
      High-concurrency, mission-critical systems deployed across digital financial services, high-throughput merchant aggregators, and national infrastructure.
    </p>
  </div>

  <!-- 4 Card Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {FLAGSHIP_PROJECTS.map((project) => (
      <div class="terminal-card p-6 flex flex-col justify-between group relative overflow-hidden">
        
        <!-- Top Glow Accent -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-cyan-500 opacity-40 group-hover:opacity-100 transition-opacity"></div>

        <div>
          <!-- Header Category & Badge -->
          <div class="flex items-center justify-between mb-3 font-mono text-xs">
            <span class="text-emerald-500 font-semibold uppercase tracking-wider">{project.category}</span>
            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold">
              {project.badgeText}
            </span>
          </div>

          <!-- Project Title -->
          <h3 class="text-xl font-bold text-[var(--text-primary)] group-hover:text-cyan-400 transition-colors font-mono mb-2">
            {project.title}
          </h3>

          <!-- Short Description -->
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
            {project.description}
          </p>

          <!-- Impact Metrics 2x2 Grid inside Card -->
          <div class="grid grid-cols-2 gap-2 my-4 p-3 rounded-lg bg-[var(--bg-main)] border border-[var(--border-color)] font-mono text-xs">
            {project.impactMetrics.map((metric) => (
              <div>
                <span class="text-[10px] text-[var(--text-muted)] block uppercase">{metric.label}</span>
                <span class="font-bold text-[var(--text-primary)] text-sm">{metric.value}</span>
              </div>
            ))}
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5 mb-4 font-mono text-[11px]">
            {project.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded bg-[var(--bg-card-hover)] border border-[var(--border-color)] text-[var(--text-muted)]">
                #{tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Deep Dive Action Link -->
        <div class="pt-4 border-t border-[var(--border-color)] flex items-center justify-between font-mono text-xs">
          <button 
            data-open-project={project.id}
            class="text-emerald-500 font-bold hover:text-emerald-400 flex items-center space-x-1 cursor-pointer transition-colors"
          >
            <span>VIEW DEEP DIVE ARCHITECTURE</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </button>
        </div>

      </div>
    ))}
  </div>

</section>

<script>
  // Link project cards to Flagship Deep Dive tab
  const projectBtns = document.querySelectorAll('[data-open-project]');
  projectBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const flagshipTabBtn = document.querySelector('[data-tab-target="flagship-tab"]');
      if (flagshipTabBtn instanceof HTMLElement) {
        flagshipTabBtn.click();
      }
    });
  });
</script>
