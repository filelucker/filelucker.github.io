---
---

<section class="py-6 border-b border-[var(--border-color)]">
  
  <div class="mb-4">
    <div class="flex items-center space-x-2 text-xs font-mono text-emerald-500 font-bold mb-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
      </svg>
      <span>ENTERPRISE TOPOLOGY ARCHITECTURE</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)] tracking-tight font-mono">
      PRODUCTION CLEAN ARCHITECTURE & BOUNDARY ENCLAVES
    </h2>
    <p class="text-sm text-[var(--text-muted)] mt-1 font-mono">
      Strict multi-module boundary isolation guaranteeing zero-leak financial data flows, Mobile AI runtime execution, POS hardware abstractions, and offline fallback queues.
    </p>
  </div>

  <!-- 4-Column Architecture Flow Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 relative">
    
    <!-- Layer 1: UI / Core Presentation -->
    <div class="terminal-card p-4 relative border-l-4 border-l-cyan-500 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[var(--border-color)] font-mono text-xs mb-3">
          <span class="font-bold text-cyan-400">01. PRESENTATION</span>
          <span class="px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 text-[10px]">REACTIVE MVI</span>
        </div>

        <div class="space-y-2.5 font-mono text-xs">
          <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
            <div class="font-bold text-[var(--text-primary)] mb-1">Jetpack Compose / Flutter</div>
            <div class="text-[11px] text-[var(--text-muted)]">Declarative UI with strict state hoisting & zero imperative side-effects.</div>
          </div>

          <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
            <div class="font-bold text-[var(--text-primary)] mb-1">MVI State Machine</div>
            <div class="text-[11px] text-[var(--text-muted)]">Unidirectional StateFlow managing immutability during payment checkouts.</div>
          </div>

          <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
            <div class="font-bold text-[var(--text-primary)] mb-1">Streaming Generative UI</div>
            <div class="text-[11px] text-[var(--text-muted)]">Real-time token rendering with typewriter micro-animations.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Layer 2: Mobile AI & On-Device ML Runtime -->
    <div class="terminal-card p-4 relative border-l-4 border-l-emerald-400 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[var(--border-color)] font-mono text-xs mb-3">
          <span class="font-bold text-emerald-400">02. MOBILE AI RUNTIME</span>
          <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 text-[10px]">SUB-20MS EDGE</span>
        </div>

        <div class="space-y-2.5 font-mono text-xs">
          <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
            <div class="font-bold text-emerald-400 mb-1">LiteRT & ONNX Mobile</div>
            <div class="text-[11px] text-[var(--text-muted)]">INT8 quantized neural inference on mobile NPU / Apple Neural Engine.</div>
          </div>

          <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
            <div class="font-bold text-[var(--text-primary)] mb-1">Edge Vision & OCR (OpenCV)</div>
            <div class="text-[11px] text-[var(--text-muted)]">Perspective transform and adaptive binarization for receipt & document capture.</div>
          </div>

          <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
            <div class="font-bold text-[var(--text-primary)] mb-1">Streaming AI & gRPC Bridge</div>
            <div class="text-[11px] text-[var(--text-muted)]">SSE / WebSocket bi-directional streaming for low-latency reasoning models.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Layer 3: Point of Sale (POS) & Security Enclave -->
    <div class="terminal-card p-4 relative border-l-4 border-l-amber-500 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[var(--border-color)] font-mono text-xs mb-3">
          <span class="font-bold text-amber-400">03. POS HAL & SECURITY</span>
          <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 text-[10px]">PCI-DSS & HAL</span>
        </div>

        <div class="space-y-2.5 font-mono text-xs">
          <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
            <div class="font-bold text-amber-400 mb-1">Universal POS HAL</div>
            <div class="text-[11px] text-[var(--text-muted)]">Drivers for Sunmi, Pax, Ingenico terminals and ESC/POS thermal printers.</div>
          </div>

          <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
            <div class="font-bold text-[var(--text-primary)] mb-1">Hardware Keystore Vault</div>
            <div class="text-[11px] text-[var(--text-muted)]">Android TEE / iOS Secure Enclave AES-256 GCM key derivation.</div>
          </div>

          <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
            <div class="font-bold text-[var(--text-primary)] mb-1">EMVCo QR & NFC Tap</div>
            <div class="text-[11px] text-[var(--text-muted)]">Instant merchant dynamic QR payload and ISO 14443 contactless kernel.</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Layer 4: Data & Offline Persistence Sync -->
    <div class="terminal-card p-4 relative border-l-4 border-l-indigo-500 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-[var(--border-color)] font-mono text-xs mb-3">
          <span class="font-bold text-indigo-400">04. DATA & SYNC ENGINE</span>
          <span class="px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-400 text-[10px]">ZERO-LOSS WAL</span>
        </div>

        <div class="space-y-2.5 font-mono text-xs">
          <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
            <div class="font-bold text-indigo-400 mb-1">SQLite Write-Ahead Log</div>
            <div class="text-[11px] text-[var(--text-muted)]">Guarantees zero corruptions during unexpected power cuts or terminal battery drain.</div>
          </div>

          <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
            <div class="font-bold text-[var(--text-primary)] mb-1">Protocol Buffers Binary</div>
            <div class="text-[11px] text-[var(--text-muted)]">Compact serialization reducing network payload overhead by 40% vs JSON.</div>
          </div>

          <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
            <div class="font-bold text-[var(--text-primary)] mb-1">Store-and-Forward Queue</div>
            <div class="text-[11px] text-[var(--text-muted)]">Idempotent background sync with exponential backoff on flaky 2G networks.</div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom Architecture Summary Bar -->
  <div class="mt-6 p-4 rounded-xl glass-panel flex flex-col md:flex-row md:items-center justify-between font-mono text-xs border border-[var(--border-color)]">
    <div class="flex items-center space-x-3 mb-2 md:mb-0">
      <span class="text-emerald-500 font-bold">SYSTEM BOUNDARY SPECS:</span>
      <span class="text-[var(--text-secondary)]">Strict Modular Separation • On-Device AI Acceleration • POS Hardware HAL • Zero Leak Policy</span>
    </div>
    <div class="flex items-center space-x-2">
      <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 text-[10px] font-bold">100% PRODUCTION VERIFIED</span>
    </div>
  </div>

</section>
