---
interface Props {
  activeTab?: string;
}

const { activeTab = 'overview-tab' } = Astro.props;

const desktopActiveClass = "tab-btn px-2.5 2xl:px-3 py-1.5 rounded-md font-bold transition-all text-emerald-600 dark:text-emerald-400 bg-[var(--bg-card)] shadow-xs border border-[var(--border-color)] cursor-pointer whitespace-nowrap text-xs";
const desktopInactiveClass = "tab-btn px-2.5 2xl:px-3 py-1.5 rounded-md font-medium transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)] border border-transparent cursor-pointer whitespace-nowrap text-xs";

const mobileActiveClass = "mobile-tab-btn shrink-0 px-3 py-1.5 text-center rounded-md font-bold transition-all bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 cursor-pointer text-xs whitespace-nowrap";
const mobileInactiveClass = "mobile-tab-btn shrink-0 px-3 py-1.5 text-center rounded-md font-medium transition-all text-[var(--text-muted)] hover:bg-[var(--bg-card-hover)] hover:text-[var(--text-primary)] border border-transparent cursor-pointer text-xs whitespace-nowrap";
---

<header class="sticky top-0 z-50 glass-panel border-b border-[var(--border-color)] transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-2 sm:gap-4">
      
      <!-- Brand & Title -->
      <div class="flex items-center min-w-0 mr-2 sm:mr-4 shrink">
        <div class="min-w-0">
          <div class="flex items-center space-x-2 sm:space-x-2.5">
            <a href="/" class="font-extrabold text-base sm:text-lg lg:text-xl tracking-tight text-[var(--text-primary)] hover:text-emerald-500 transition-colors whitespace-nowrap shrink-0">
              Md Moniruzzaman
            </a>
            <span class="inline-flex items-center px-1.5 sm:px-2 py-0.5 rounded text-[10px] sm:text-[11px] font-mono bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 font-semibold whitespace-nowrap shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1 sm:mr-1.5 pulse-dot"></span>
              <span class="hidden sm:inline">ACTIVE FOR CONSULTING</span>
              <span class="sm:hidden">ACTIVE</span>
            </span>
          </div>
          <p class="text-xs text-[var(--text-muted)] font-mono truncate hidden md:block whitespace-nowrap" title="Senior Mobile Engineer & Systems Architect | Mobile AI Engineer | POS & Fintech Specialist">
            Senior Mobile Engineer & Systems Architect | Mobile AI Engineer | POS & Fintech Specialist
          </p>
        </div>
      </div>

      <!-- Right Controls & Navigation -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <!-- Navigation Tabs (Clean-URL view switcher) -->
        <nav class="hidden xl:flex items-center space-x-1 font-mono text-xs bg-[var(--bg-main)] p-1 rounded-lg border border-[var(--border-color)] shrink-0">
          <button 
            data-tab-target="overview-tab"
            class={activeTab === 'overview-tab' ? desktopActiveClass : desktopInactiveClass}
          >
            01. Overview
          </button>
          <button 
            data-tab-target="flagship-tab"
            class={activeTab === 'flagship-tab' ? desktopActiveClass : desktopInactiveClass}
          >
            02. Flagship Projects
          </button>
          <button 
            data-tab-target="skills-tab"
            class={activeTab === 'skills-tab' ? desktopActiveClass : desktopInactiveClass}
          >
            03. Skills & Timeline
          </button>
          <button 
            data-tab-target="playbook-tab"
            class={activeTab === 'playbook-tab' ? desktopActiveClass : desktopInactiveClass}
          >
            04. System Deep Dives
          </button>
        </nav>

        <!-- Theme Toggle Button -->
        <button 
          id="theme-toggle" 
          type="button" 
          aria-label="Toggle Theme"
          class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center rounded-lg text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-card-hover)] transition-colors border border-[var(--border-color)] cursor-pointer shrink-0"
        >
          <!-- Sun Icon for Light Mode -->
          <svg id="theme-toggle-light-icon" class="hidden w-4 h-4 sm:w-4.5 sm:h-4.5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
          </svg>
          <!-- Moon Icon for Dark Mode -->
          <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4 sm:w-4.5 sm:h-4.5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
        </button>

        <!-- Mobile Resume Download CTA Trigger (visible < sm) -->
        <a 
          id="open-resume-modal-mobile" 
          href="/Md_Moniruzzaman_Senior_Mobile_Engineer_Resume.pdf"
          download="Md_Moniruzzaman_Senior_Mobile_Engineer_Resume.pdf"
          aria-label="Download Resume PDF"
          title="Download Resume (PDF)"
          class="sm:hidden w-9 h-9 flex items-center justify-center rounded-lg text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 transition-colors cursor-pointer shrink-0 active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
        </a>

        <!-- Desktop Resume Download CTA -->
        <a 
          id="open-resume-modal" 
          href="/Md_Moniruzzaman_Senior_Mobile_Engineer_Resume.pdf"
          download="Md_Moniruzzaman_Senior_Mobile_Engineer_Resume.pdf"
          class="hidden sm:inline-flex items-center justify-center space-x-1.5 sm:space-x-2 h-10 px-3 sm:px-4 py-2 rounded-lg font-mono text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white transition-all shadow-md shadow-emerald-500/20 active:scale-95 cursor-pointer shrink-0"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          <span class="whitespace-nowrap hidden xl:inline 2xl:hidden">RESUME</span>
          <span class="whitespace-nowrap hidden 2xl:inline">DOWNLOAD RESUME (PDF)</span>
          <span class="whitespace-nowrap xl:hidden">RESUME (PDF)</span>
        </a>
      </div>

    </div>
  </div>

  <!-- Mobile & Tablet View Selector Horizontal Scrolling Track -->
  <div class="xl:hidden border-t border-[var(--border-color)] bg-[var(--bg-main)] px-2 sm:px-4 py-1.5">
    <div class="flex items-center gap-1.5 font-mono text-xs overflow-x-auto no-scrollbar py-0.5">
      <button data-tab-target="overview-tab" class={activeTab === 'overview-tab' ? mobileActiveClass : mobileInactiveClass}>
        01. Overview
      </button>
      <button data-tab-target="flagship-tab" class={activeTab === 'flagship-tab' ? mobileActiveClass : mobileInactiveClass}>
        02. Flagship Projects
      </button>
      <button data-tab-target="skills-tab" class={activeTab === 'skills-tab' ? mobileActiveClass : mobileInactiveClass}>
        03. Skills & Timeline
      </button>
      <button data-tab-target="playbook-tab" class={activeTab === 'playbook-tab' ? mobileActiveClass : mobileInactiveClass}>
        04. System Deep Dives
      </button>
    </div>
  </div>
</header>

<script>
  // Theme Toggle Logic
  const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
  const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
  const themeToggleBtn = document.getElementById('theme-toggle');

  if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark');
    themeToggleLightIcon?.classList.remove('hidden');
  } else {
    document.documentElement.classList.remove('dark');
    themeToggleDarkIcon?.classList.remove('hidden');
  }

  themeToggleBtn?.addEventListener('click', () => {
    themeToggleDarkIcon?.classList.toggle('hidden');
    themeToggleLightIcon?.classList.toggle('hidden');

    if (localStorage.getItem('color-theme')) {
      if (localStorage.getItem('color-theme') === 'light') {
        document.documentElement.classList.add('dark');
        localStorage.setItem('color-theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('color-theme', 'light');
      }
    } else {
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('color-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('color-theme', 'dark');
      }
    }
  });

  // Tab & Clean URL Switcher Logic
  const desktopTabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const mobileTabBtns = document.querySelectorAll<HTMLButtonElement>('.mobile-tab-btn');
  const allTabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn, .mobile-tab-btn');
  const tabContents = document.querySelectorAll<HTMLElement>('.tab-content');

  const SLUG_TO_TAB: Record<string, string> = {
    '': 'overview-tab',
    'overview': 'overview-tab',
    'flagship': 'flagship-tab',
    'projects': 'flagship-tab',
    'skills': 'skills-tab',
    'timeline': 'skills-tab',
    'playbook': 'playbook-tab',
    'deep-dives': 'playbook-tab'
  };

  const TAB_TO_SLUG: Record<string, string> = {
    'overview-tab': '',
    'flagship-tab': 'flagship',
    'skills-tab': 'skills',
    'playbook-tab': 'playbook'
  };

  function activateTab(targetId: string, updateUrl: boolean = true, pushState: boolean = true) {
    if (!targetId) return;

    // Update Desktop Buttons Styling
    desktopTabBtns.forEach(b => {
      const isTarget = b.getAttribute('data-tab-target') === targetId;
      if (isTarget) {
        b.className = "tab-btn px-2.5 2xl:px-3 py-1.5 rounded-md font-bold transition-all text-emerald-600 dark:text-emerald-400 bg-[var(--bg-card)] shadow-xs border border-[var(--border-color)] cursor-pointer whitespace-nowrap text-xs";
      } else {
        b.className = "tab-btn px-2.5 2xl:px-3 py-1.5 rounded-md font-medium transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)] border border-transparent cursor-pointer whitespace-nowrap text-xs";
      }
    });

    // Update Mobile Buttons Styling
    mobileTabBtns.forEach(b => {
      const isTarget = b.getAttribute('data-tab-target') === targetId;
      if (isTarget) {
        b.className = "mobile-tab-btn shrink-0 px-3 py-1.5 text-center rounded-md font-bold transition-all bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 cursor-pointer text-xs whitespace-nowrap";
      } else {
        b.className = "mobile-tab-btn shrink-0 px-3 py-1.5 text-center rounded-md font-medium transition-all text-[var(--text-muted)] hover:bg-[var(--bg-card-hover)] hover:text-[var(--text-primary)] border border-transparent cursor-pointer text-xs whitespace-nowrap";
      }
    });

    // Toggle Content Sections
    tabContents.forEach(content => {
      if (content.id === targetId) {
        content.classList.remove('hidden');
        content.classList.add('animate-fadeIn');
      } else {
        content.classList.add('hidden');
      }
    });

    if (updateUrl) {
      const slug = TAB_TO_SLUG[targetId] ?? '';
      const newPath = slug ? `/${slug}` : '/';
      const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
      const targetCleanPath = newPath.replace(/\/$/, '') || '/';
      
      if (currentPath !== targetCleanPath || window.location.hash) {
        if (pushState) {
          history.pushState({ targetId }, '', newPath);
        } else {
          history.replaceState({ targetId }, '', newPath);
        }
      }
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  allTabBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = btn.getAttribute('data-tab-target');
      if (targetId) activateTab(targetId, true, true);
    });
  });

  // Handle Browser Back / Forward buttons
  window.addEventListener('popstate', (e) => {
    if (e.state && e.state.targetId) {
      activateTab(e.state.targetId, false);
    } else {
      const cleanPath = window.location.pathname.replace(/^\/|\/$/g, '');
      const targetId = SLUG_TO_TAB[cleanPath] || 'overview-tab';
      activateTab(targetId, false);
    }
  });

  // Handle initial page load & upgrade legacy hash links
  window.addEventListener('load', () => {
    if (window.location.hash) {
      const rawHash = window.location.hash.replace('#', '');
      const mappedTab = SLUG_TO_TAB[rawHash] || `${rawHash}-tab`;
      if (document.getElementById(mappedTab)) {
        // Upgrade legacy hash link to clean URL without #
        activateTab(mappedTab, true, false);
        return;
      }
    }

    const cleanPath = window.location.pathname.replace(/^\/|\/$/g, '');
    if (cleanPath && SLUG_TO_TAB[cleanPath]) {
      const targetId = SLUG_TO_TAB[cleanPath];
      if (document.getElementById(targetId)) {
        activateTab(targetId, false);
      }
    }
  });
</script>
