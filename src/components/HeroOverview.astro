---
import { HERO_METRICS, INDUSTRY_ROLE_PROFILES, CONTACT_INFO } from '../data/portfolioData';
---

<section class="py-4 lg:py-6 border-b border-[var(--border-color)]">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    
    <!-- Left Hero Headline & Actions (7 Columns) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- System Architecture & Role Badges (Merged) -->
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
        <div class="inline-flex items-center space-x-1.5 sm:space-x-2 px-2.5 sm:px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-600 dark:text-cyan-400 font-mono text-[10px] sm:text-xs font-semibold">
          <svg class="w-3 sm:w-3.5 h-3 sm:h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          <span>HIGH-CONCURRENCY FINTECH & MOBILE ARCHITECTURE</span>
        </div>
        <div class="inline-flex items-center space-x-1.5 px-2.5 sm:px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 font-mono text-[10px] sm:text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 pulse-dot shrink-0"></span>
          <span>MOBILE AI ENGINEER (TOP RECOMMENDATION)</span>
        </div>
        <div class="inline-flex items-center space-x-1.5 px-2.5 sm:px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-600 dark:text-indigo-400 font-mono text-[10px] sm:text-xs font-semibold">
          <span>POINT OF SALE (POS) FLEET</span>
        </div>
      </div>

      <!-- Main Heading (Offline-First Mobile AI first + POS glowing gradient) -->
      <h1 class="text-2xl xs:text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.18] sm:leading-[1.15] break-words">
        ENGINEERING <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 via-cyan-500 to-indigo-500 dark:from-emerald-400 dark:via-cyan-400 dark:to-indigo-400">OFFLINE-FIRST MOBILE AI ARCHITECTURE</span>, <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 via-cyan-500 to-indigo-500 dark:from-emerald-400 dark:via-cyan-400 dark:to-indigo-400">POINT OF SALE (POS)</span> & RESILIENT, HIGH-CONCURRENCY MOBILE SYSTEMS
      </h1>

      <!-- Subtitle Description (Merged) -->
      <p class="text-sm sm:text-base lg:text-lg text-[var(--text-secondary)] leading-relaxed font-normal">
        Architected Fintech & Point of Sale (POS) platforms serving <strong class="text-[var(--text-primary)] font-semibold">50M+ active merchants</strong> and <strong class="text-[var(--text-primary)] font-semibold">1M+ consumer downloads</strong> across Bangladesh and high-throughput international enterprise operations. Specializing in on-device AI inference (LiteRT, ONNX, CoreML), zero-trust PCI-DSS payment platforms, hardware-backed biometric verification, native engine bridges, and aggressive crash-mitigation under extreme low-bandwidth networks.
      </p>

        <!-- Hero Direct Resume Download CTA -->
        <a 
          id="hero-download-resume"
          href="/Md_Moniruzzaman_Senior_Mobile_Engineer_Resume.pdf"
          download="Md_Moniruzzaman_Senior_Mobile_Engineer_Resume.pdf"
          class="w-full sm:w-[210px] h-10 inline-flex items-center justify-center space-x-2 px-4 py-2 rounded-lg font-mono text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/25 transition-all cursor-pointer hover:-translate-y-0.5 shrink-0"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          <span class="whitespace-nowrap">DOWNLOAD RESUME (PDF)</span>
        </a>

        <!-- Tab Switcher Trigger for Flagship Projects -->
        <button 
          data-tab-trigger="flagship-tab"
          class="w-full sm:w-auto min-w-[210px] inline-flex items-center justify-center space-x-2 px-4 py-2.5 rounded-lg font-mono text-xs font-bold glass-panel text-[var(--text-primary)] hover:border-emerald-500/50 transition-all cursor-pointer hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          <span>FLAGSHIP PROJECTS</span>
        </button>

        <a 
          href={CONTACT_INFO.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 px-3.5 py-2.5 rounded-lg font-mono text-xs font-bold bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-cyan-500/50 transition-all"
          title="GitHub: https://github.com/filelucker"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          <span>GITHUB</span>
        </a>

        <a 
          href={CONTACT_INFO.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 px-3.5 py-2.5 rounded-lg font-mono text-xs font-bold bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-cyan-400 hover:border-cyan-500/50 transition-all"
          title="LinkedIn: https://www.linkedin.com/in/mon000"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          <span>LINKEDIN</span>
        </a>

        <a 
          href={CONTACT_INFO.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-1.5 px-3.5 py-2.5 rounded-lg font-mono text-xs font-bold bg-[var(--bg-card)] border border-[var(--border-color)] text-emerald-500 hover:text-emerald-400 hover:border-emerald-500/50 transition-all"
          title="WhatsApp / Phone: +8801721915013"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>WHATSAPP</span>
        </a>

        <!-- Copy Email Button -->
        <button 
          id="copy-email-btn"
          class="inline-flex items-center space-x-1.5 px-3 py-2.5 rounded-lg font-mono text-xs text-[var(--text-muted)] hover:text-emerald-500 transition-colors cursor-pointer max-w-full"
          title="Click to copy email address"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
          </svg>
          <span id="email-text" class="truncate">{CONTACT_INFO.email}</span>
        </button>
      </div>

    </div>

    <!-- Right Profile Card (5 Columns, Original Preserved) -->
    <div class="lg:col-span-5 flex justify-center lg:justify-end">
      <div class="relative group w-full max-w-sm">
        
        <!-- Glowing Ambient Glow -->
        <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-emerald-500 to-cyan-500 opacity-30 blur-lg group-hover:opacity-60 transition duration-500"></div>

        <div class="relative rounded-2xl p-5 glass-panel border border-[var(--border-color)] overflow-hidden shadow-2xl">
          
          <!-- Portrait Image Container -->
          <div class="relative rounded-xl overflow-hidden aspect-[4/5] mb-4 group/img">
            <img 
              src="/profile.jpg" 
              alt="Md Moniruzzaman Profile" 
              class="w-full h-full object-cover object-top filter contrast-[1.03] group-hover/img:scale-105 transition duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-card)] via-transparent to-transparent opacity-40"></div>
          </div>

          <!-- Quick Bio Tags (Original Preserved) -->
          <div class="space-y-2 font-mono text-xs">
            <div class="flex justify-between items-center pb-2 border-b border-[var(--border-color)]">
              <span class="text-[var(--text-muted)]">CORE FOCUS:</span>
              <span class="font-semibold text-emerald-500">Fintech, Security & Native Bridges</span>
            </div>
            <div class="flex justify-between items-center pb-2 border-b border-[var(--border-color)]">
              <span class="text-[var(--text-muted)]">EXPERIENCE:</span>
              <span class="font-semibold text-[var(--text-primary)]">11+ Years Production Systems</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-[var(--text-muted)]">USER BASE:</span>
              <span class="font-semibold text-cyan-400">50M+ Merchant & Consumer Operations</span>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div>

  <!-- Key Metrics Row (4 Card Grid matching original UI board) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mt-6">
    {HERO_METRICS.map((metric) => (
      <div class="terminal-card p-4 sm:p-5 relative overflow-hidden group">
        <!-- Top accent line -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-cyan-500 opacity-60 group-hover:opacity-100 transition-opacity"></div>
        
        <div class="flex items-baseline justify-between mb-1">
          <div class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-mono text-[var(--text-primary)] group-hover:text-emerald-500 transition-colors">
            {metric.value}
          </div>
          {metric.trend && (
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold shrink-0">
              {metric.trend}
            </span>
          )}
        </div>

        <div class="font-mono text-xs font-bold text-[var(--text-primary)] tracking-wide uppercase mt-1">
          {metric.label}
        </div>

        <div class="text-[11px] font-mono text-[var(--text-muted)] mt-1 line-clamp-1">
          {metric.sublabel}
        </div>
      </div>
    ))}
  </div>

  <!-- Merged Role Specializations & Industry Perception Section -->
  <div class="mt-8 space-y-4">
    <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3 font-mono">
      <div class="flex items-center space-x-2">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 shrink-0"></span>
        <h3 class="text-xs sm:text-sm md:text-base font-bold text-[var(--text-primary)] tracking-tight uppercase">
          ENGINEERING PILLARS & INDUSTRY ROLE PERCEPTION
        </h3>
      </div>
      <span class="text-xs text-[var(--text-muted)] hidden sm:inline font-mono">RECRUITER ALIGNMENT</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {INDUSTRY_ROLE_PROFILES.map((profile) => (
        <div class="terminal-card p-4 sm:p-5 rounded-xl border border-[var(--border-color)] flex flex-col justify-between hover:border-emerald-500/40 transition-all group">
          <div class="space-y-3">
            <!-- Role Title & Badge (Stacked vertically) -->
            <div class="space-y-1.5 font-mono">
              <h4 class="font-bold text-sm sm:text-base text-[var(--text-primary)] group-hover:text-emerald-400 transition-colors leading-snug">
                {profile.role}
              </h4>
              <div>
                <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ${
                  profile.badge.includes('Top') 
                    ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40' 
                    : profile.badge.includes('Searchable')
                    ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40'
                    : profile.badge.includes('Hardware')
                    ? 'bg-indigo-500/20 text-indigo-300 border border-indigo-500/40'
                    : 'bg-amber-500/20 text-amber-300 border border-amber-500/40'
                }`}>
                  {profile.badge}
                </span>
              </div>
            </div>

            <!-- Industry Perception Quote Box -->
            <div class="p-3 rounded-lg bg-[var(--bg-main)] border-l-2 border-emerald-500/60 font-mono text-xs text-[var(--text-secondary)] space-y-1">
              <span class="text-[10px] uppercase font-bold text-emerald-500 block">Industry Perception:</span>
              <p class="italic leading-relaxed">"{profile.industryPerception}"</p>
            </div>

            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              {profile.summary}
            </p>

            <!-- Key Capabilities List -->
            <ul class="space-y-1.5 font-mono text-[11px] text-[var(--text-muted)] pt-1">
              {profile.highlights.map((item) => (
                <li class="flex items-start space-x-1.5">
                  <span class="text-emerald-500 font-bold">▸</span>
                  <span class="leading-tight">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Tech Pillars Badges -->
          <div class="pt-4 border-t border-[var(--border-color)] mt-4">
            <div class="flex flex-wrap gap-1 font-mono text-[10px]">
              {profile.techPillars.map((tech) => (
                <span class="px-2 py-0.5 rounded bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--text-secondary)]">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

</section>

<script>
  // Copy Email Script
  const copyBtn = document.getElementById('copy-email-btn');
  const emailText = document.getElementById('email-text');

  copyBtn?.addEventListener('click', () => {
    const email = 'm.zaman000@gmail.com';
    navigator.clipboard.writeText(email).then(() => {
      if (emailText) {
        const originalText = emailText.textContent;
        emailText.textContent = 'COPIED TO CLIPBOARD!';
        emailText.classList.add('text-emerald-400', 'font-bold');
        setTimeout(() => {
          emailText.textContent = originalText;
          emailText.classList.remove('text-emerald-400', 'font-bold');
        }, 2000);
      }
    });
  });

  // Hero CTA to Tab Switcher
  const flagshipBtn = document.querySelectorAll('[data-tab-trigger="flagship-tab"]');
  flagshipBtn.forEach(btn => {
    btn.addEventListener('click', () => {
      const flagshipTabBtn = document.querySelector('[data-tab-target="flagship-tab"]');
      if (flagshipTabBtn instanceof HTMLElement) {
        flagshipTabBtn.click();
      }
    });
  });
</script>
