---

<div id="resume-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4">
  
  <div class="relative w-full max-w-4xl glass-panel rounded-2xl border border-[var(--border-color)] shadow-2xl overflow-hidden animate-fadeIn my-8">
    
    <!-- Modal Top Bar -->
    <div class="flex items-center justify-between px-6 py-4 bg-[var(--bg-card)] border-b border-[var(--border-color)] font-mono">
      <div class="flex items-center space-x-2">
        <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
        <h3 class="font-bold text-sm sm:text-base text-[var(--text-primary)]">
          Md_Moniruzzaman_Senior_Mobile_Engineer_Resume.pdf
        </h3>
      </div>

      <div class="flex items-center space-x-3">
        <a 
          href="/Md_Moniruzzaman_Senior_Mobile_Engineer_Resume.pdf" 
          download
          class="px-3.5 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-mono text-xs font-bold transition-all shadow-md flex items-center space-x-1.5"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          <span>DOWNLOAD FILE</span>
        </a>

        <button 
          id="close-resume-modal" 
          class="p-1.5 rounded-lg text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-card-hover)] transition-colors cursor-pointer"
          aria-label="Close modal"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Resume Document Viewport Container -->
    <div class="p-6 sm:p-8 space-y-6 max-h-[75vh] overflow-y-auto font-mono text-xs text-[var(--text-secondary)] bg-[var(--bg-main)]">
      
      <!-- Document Header -->
      <div class="border-b border-[var(--border-color)] pb-4 space-y-1">
        <h1 class="text-2xl font-extrabold text-[var(--text-primary)]">Md Moniruzzaman</h1>
        <p class="text-emerald-500 font-bold">Senior Mobile Engineer & Systems Architect | Mobile AI Engineer | POS & Fintech Specialist</p>
        <p class="text-[var(--text-muted)] text-[11px]">
          Dhaka, Bangladesh • m.zaman000@gmail.com • +8801721915013 • github.com/filelucker • linkedin.com/in/mon000
        </p>
      </div>

      <!-- Executive Summary -->
      <div class="space-y-2">
        <h4 class="font-bold text-[var(--text-primary)] uppercase text-xs tracking-wider border-b border-[var(--border-color)] pb-1">
          Executive Summary
        </h4>
        <p class="leading-relaxed">
          Results-driven Senior Mobile Architect and Mobile AI Engineer with 11+ years of experience engineering high-concurrency fintech platforms, biometric hardware integrations, Point of Sale (POS) terminal fleets (10,000+ devices), and offline-first mobile runtimes serving over 50M+ users. Proven track record leading mobile development teams for national scale systems (MYCash DFS 1M+ users, DGePay Merchant & POS Platform, CPTU e-GP procurement). Expert in bridging client apps (Android, iOS, Flutter) with AI capabilities—including on-device neural inference (LiteRT, ONNX, CoreML) and streaming interfaces—alongside Kotlin, Android NDK (C/C++), PCI-DSS compliance, and zero-trust security.
        </p>
      </div>

      <!-- Core Specs -->
      <div class="space-y-2">
        <h4 class="font-bold text-[var(--text-primary)] uppercase text-xs tracking-wider border-b border-[var(--border-color)] pb-1">
          Technical Competencies & Systems
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-[11px]">
          <div>• <strong>Languages:</strong> Kotlin, Java, Dart, C/C++ (NDK), Swift, Rust</div>
          <div>• <strong>Architecture:</strong> Clean Architecture, MVI, ReactiveX, Coroutines, StateFlow</div>
          <div>• <strong>Mobile AI:</strong> LiteRT (TFLite), ONNX Mobile, CoreML, Cloud AI (SSE/gRPC), OpenCV</div>
          <div>• <strong>POS & Hardware:</strong> Universal POS HAL (Sunmi, Pax, Ingenico), ESC/POS Thermal, EMVCo QR/NFC</div>
          <div>• <strong>Security:</strong> PCI-DSS, Hardware Keystore, AES-GCM, Biometric Prompt API</div>
          <div>• <strong>Database & Sync:</strong> SQLite WAL, Room, Realm, Protocol Buffers, WorkManager</div>
        </div>
      </div>

      <!-- Experience Highlights -->
      <div class="space-y-3">
        <h4 class="font-bold text-[var(--text-primary)] uppercase text-xs tracking-wider border-b border-[var(--border-color)] pb-1">
          Experience Highlights
        </h4>
        
        <div class="space-y-1">
          <div class="flex justify-between font-bold text-[var(--text-primary)]">
            <span>Lead Software Developer / Mobile Architect — DNET</span>
            <span class="text-emerald-500">2021 — PRESENT</span>
          </div>
          <p class="text-[11px]">Spearheaded architecture for MYCash (1M+ users) and DGePay (10K+ merchant POS terminals). Reduced offline network sync drop rates by 98%.</p>
        </div>

        <div class="space-y-1">
          <div class="flex justify-between font-bold text-[var(--text-primary)]">
            <span>Senior Android Developer — TeleTalk / Tech Engagements</span>
            <span class="text-emerald-500">2018 — 2021</span>
          </div>
          <p class="text-[11px]">Refactored legacy telecom payment portals to Kotlin Coroutines and modular architecture. Optimized memory footprint by 45%.</p>
        </div>
      </div>

    </div>

    <!-- Modal Footer Actions -->
    <div class="px-6 py-4 bg-[var(--bg-card)] border-t border-[var(--border-color)] flex justify-between items-center font-mono text-xs">
      <span class="text-[var(--text-muted)]">Verified Resume Artifact</span>
      <button 
        id="modal-close-btn-bottom"
        class="px-4 py-2 rounded-lg bg-[var(--bg-card-hover)] border border-[var(--border-color)] text-[var(--text-primary)] hover:border-emerald-500/50 transition-colors cursor-pointer"
      >
        Close Preview
      </button>
    </div>

  </div>
</div>

<script>
  // Modal toggle logic
  const modal = document.getElementById('resume-modal');
  const openBtns = document.querySelectorAll('#open-resume-modal, #hero-download-resume');
  const closeBtns = document.querySelectorAll('#close-resume-modal, #modal-close-btn-bottom');

  openBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      modal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    });
  });

  closeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      modal?.classList.add('hidden');
      document.body.style.overflow = 'auto';
    });
  });

  // Close modal when clicking outside box
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }
  });
</script>
