---
import { RUNTIME_CODE_SNIPPET } from '../data/portfolioData';
---

<section class="py-10 border-b border-[var(--border-color)]">
  
  <!-- Section Title -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-6">
    <div>
      <div class="flex items-center space-x-2 text-xs font-mono text-emerald-500 font-bold mb-1">
        <span class="w-2 h-2 rounded-full bg-emerald-500 pulse-dot"></span>
        <span>LIVE RUNTIME DIAGNOSTICS & ENGINE SIMULATOR</span>
      </div>
  <!-- Section Title -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-6">
    <div>
      <div class="flex items-center space-x-2 text-xs font-mono text-emerald-500 font-bold mb-1">
        <span class="w-2 h-2 rounded-full bg-emerald-500 pulse-dot"></span>
        <span>LIVE RUNTIME DIAGNOSTICS & ENGINE SIMULATOR</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)] tracking-tight font-mono">
        FINTECH ENGINE VIEWPORT: TRANSACTION RUNTIME
      </h2>
    </div>
    <div class="mt-3 md:mt-0 flex items-center space-x-2 font-mono text-xs">
      <span class="px-2.5 py-1 rounded glass-panel text-[var(--text-muted)] border border-[var(--border-color)]">
        PCI-DSS ENCLAVE: ACTIVE
      </span>
      <span class="px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-400 font-semibold border border-emerald-500/30">
        OFFLINE BUFFER: ONLINE
      </span>
    </div>
  </div>

  <!-- Main Viewport Box (2 Columns) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
    
    <!-- Left: Interactive Mobile Device Mockup (5 Columns) -->
    <div class="lg:col-span-5 flex flex-col">
      <div class="terminal-card p-5 h-full flex flex-col justify-between relative overflow-hidden bg-gradient-to-b from-[var(--bg-card)] to-[var(--bg-main)]">
        
        <!-- Top Device Header -->
        <div class="flex items-center justify-between pb-4 border-b border-[var(--border-color)] font-mono text-xs">
          <div class="flex items-center space-x-2">
            <div class="w-2.5 h-2.5 rounded-full bg-red-500"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-yellow-500"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-green-500"></div>
            <span class="font-bold text-[var(--text-primary)] ml-2">Fintech Core Terminal</span>
          </div>
        </div>

        <!-- Phone Card Viewport -->
        <div class="my-6 space-y-4">
          
          <!-- Balance Display Card -->
          <div class="p-5 rounded-xl bg-gradient-to-br from-slate-900 to-emerald-950 text-white shadow-xl border border-emerald-500/30">
            <div class="flex justify-between items-center text-xs font-mono text-emerald-400/80 mb-2">
              <span>MERCHANT LIQUIDITY POOL</span>
              <span class="px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300">ISO-20022</span>
            </div>
            <div class="flex items-center justify-between">
              <div id="demo-balance-text" class="text-2xl sm:text-3xl font-extrabold font-mono tracking-tight text-emerald-400">
                ••••••••••••
              </div>
              <button 
                id="toggle-balance-btn" 
                class="text-[11px] font-mono px-2 py-1 rounded bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 transition-colors border border-emerald-500/30 cursor-pointer shrink-0 ml-2"
                title="Toggle simulated demo balance"
              >
                UNMASK DEMO
              </button>
            </div>
            <div class="flex justify-between items-center text-[11px] font-mono text-slate-300 mt-4 pt-3 border-t border-emerald-500/20">
              <span>Interoperable Merchant Node</span>
              <span class="text-emerald-400">● 100% SECURE</span>
            </div>
          </div>

          <!-- Live Transaction Status Box -->
          <div class="p-4 rounded-lg glass-panel space-y-2 border border-[var(--border-color)]">
            <div class="flex justify-between items-center text-xs font-mono">
              <span class="text-[var(--text-muted)]">INBOUND TRANSACTIONS:</span>
              <span id="sim-status" class="text-emerald-400 font-bold">QUEUED & SIGNED</span>
            </div>
            <div class="w-full bg-[var(--bg-main)] h-2 rounded-full overflow-hidden border border-[var(--border-color)]">
              <div id="sim-progress-bar" class="bg-gradient-to-r from-emerald-500 to-cyan-500 h-full w-3/4 transition-all duration-500"></div>
            </div>
            <div class="flex justify-between items-center text-[10px] font-mono text-[var(--text-muted)] pt-1">
              <span>LOCAL WAL: COMMIT_OK</span>
              <span>PAYLOAD CRC: 0x9F4A2B</span>
            </div>
          </div>

          <!-- Interactive Test Action Trigger -->
          <button 
            id="run-sim-btn" 
            class="w-full py-3 rounded-lg font-mono text-xs font-bold bg-gradient-to-r from-emerald-600 to-cyan-600 hover:from-emerald-500 hover:to-cyan-500 text-white transition-all shadow-lg shadow-emerald-500/20 cursor-pointer flex items-center justify-center space-x-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>SIMULATE OFFLINE TRANSACTION EXECUTION</span>
          </button>
        </div>

        <!-- System Architecture Footnote -->
        <div class="pt-3 border-t border-[var(--border-color)] font-mono text-[11px] text-[var(--text-muted)] flex justify-between">
          <span>Target Network: 2G / Edge</span>
          <span>Zero Data Loss Policy</span>
        </div>

      </div>
    </div>

    <!-- Right: Code Viewport & Real-time Metrics (7 Columns) -->
    <div class="lg:col-span-7 flex flex-col">
      <div class="code-viewport rounded-xl overflow-hidden h-full flex flex-col justify-between shadow-2xl border border-[var(--border-color)]">
        
        <!-- Code File Header -->
        <div class="flex items-center justify-between px-4 py-3 bg-slate-900 border-b border-slate-800 font-mono text-xs">
          <div class="flex items-center space-x-2 text-slate-300">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
            <span class="font-bold">OfflinePaymentEngine.kt</span>
            <span class="text-slate-500">| Core Security Enclave</span>
          </div>
          <button 
            id="copy-code-btn" 
            class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors text-[11px]"
          >
            Copy Code
          </button>
        </div>

        <!-- Real-Time Metrics Bar (Matching image 1 design) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 p-3 bg-slate-950 border-b border-slate-800/80 font-mono text-[11px]">
          <div class="p-2 rounded bg-slate-900/90 border border-slate-800">
            <span class="text-slate-400 block text-[10px]">HANDSHAKE CRYPTO</span>
            <span id="metric-handshake" class="font-bold text-cyan-400">43ms</span>
          </div>
          <div class="p-2 rounded bg-slate-900/90 border border-slate-800">
            <span class="text-slate-400 block text-[10px]">OFFLINE QUEUE STORAGE</span>
            <span id="metric-storage" class="font-bold text-emerald-400">12ms</span>
          </div>
          <div class="p-2 rounded bg-slate-900/90 border border-slate-800">
            <span class="text-slate-400 block text-[10px]">DATA PACK COMPRESSION</span>
            <span id="metric-compression" class="font-bold text-indigo-400">21ms</span>
          </div>
          <div class="p-2 rounded bg-slate-900/90 border border-slate-800">
            <span class="text-slate-400 block text-[10px]">TOTAL DURATION (TTC)</span>
            <span id="metric-total" class="font-bold text-emerald-400">76ms</span>
          </div>
        </div>

        <!-- Code Block Content -->
        <div class="p-4 overflow-x-auto text-xs leading-relaxed font-mono text-slate-200 bg-[#060911] flex-1">
          <pre class="whitespace-pre"><code>{RUNTIME_CODE_SNIPPET}</code></pre>
        </div>

        <!-- Live Output Terminal Log Bar -->
        <div id="sim-terminal-log" class="p-3 bg-slate-950 border-t border-slate-800 font-mono text-[11px] text-emerald-400/90 flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <span class="text-slate-500">&gt;</span>
            <span id="log-text">System initialized. Ready for offline transaction payload stream.</span>
          </div>
          <span class="text-slate-500 hidden sm:inline">LATENCY_OK</span>
        </div>

      </div>
    </div>

  </div>

</section>

<script>
  // Simulation Interactivity Logic
  const runSimBtn = document.getElementById('run-sim-btn');
  const simStatus = document.getElementById('sim-status');
  const simProgressBar = document.getElementById('sim-progress-bar');
  const logText = document.getElementById('log-text');
  const metricHandshake = document.getElementById('metric-handshake');
  const metricStorage = document.getElementById('metric-storage');
  const metricCompression = document.getElementById('metric-compression');
  const metricTotal = document.getElementById('metric-total');

  runSimBtn?.addEventListener('click', () => {
    if (!runSimBtn || !simStatus || !simProgressBar || !logText) return;

    runSimBtn.setAttribute('disabled', 'true');
    simStatus.textContent = 'EXECUTING CRYPTO HANDSHAKE...';
    simStatus.className = 'text-cyan-400 font-bold';
    logText.textContent = '[00:01.02] Generating AES-256 GCM ephemeral nonce in Hardware Keystore...';
    simProgressBar.style.width = '25%';

    setTimeout(() => {
      simStatus.textContent = 'COMMITTING TO LOCAL WAL DATABASE...';
      simStatus.className = 'text-yellow-400 font-bold';
      logText.textContent = '[00:01.04] Writing signed envelope to SQLite Write-Ahead Log (WAL)...';
      simProgressBar.style.width = '60%';
    }, 400);

    setTimeout(() => {
      const randHandshake = Math.floor(Math.random() * 10) + 38;
      const randStorage = Math.floor(Math.random() * 5) + 10;
      const randCompression = Math.floor(Math.random() * 8) + 18;
      const total = randHandshake + randStorage + randCompression;

      if (metricHandshake) metricHandshake.textContent = `${randHandshake}ms`;
      if (metricStorage) metricStorage.textContent = `${randStorage}ms`;
      if (metricCompression) metricCompression.textContent = `${randCompression}ms`;
      if (metricTotal) metricTotal.textContent = `${total}ms`;

      simStatus.textContent = 'QUEUED & SIGNED (SUB-100MS SUCCESS)';
      simStatus.className = 'text-emerald-400 font-bold';
      logText.textContent = `[00:01.07] Tx committed successfully! Total execution time: ${total}ms.`;
      simProgressBar.style.width = '100%';
      runSimBtn.removeAttribute('disabled');
    }, 900);
  });

  // Copy Code Button
  const copyCodeBtn = document.getElementById('copy-code-btn');
  copyCodeBtn?.addEventListener('click', () => {
    const codeText = `package com.mycash.fintech.engine.security...`;
    navigator.clipboard.writeText(codeText).then(() => {
      copyCodeBtn.textContent = 'Copied!';
      setTimeout(() => { copyCodeBtn.textContent = 'Copy Code'; }, 2000);
    });
  });

  // Balance unmask toggle logic
  const toggleBalanceBtn = document.getElementById('toggle-balance-btn');
  const demoBalanceText = document.getElementById('demo-balance-text');
  let isUnmasked = false;

  toggleBalanceBtn?.addEventListener('click', () => {
    if (!demoBalanceText || !toggleBalanceBtn) return;
    isUnmasked = !isUnmasked;
    if (isUnmasked) {
      demoBalanceText.textContent = '$4,821,950.00 (DEMO)';
      demoBalanceText.classList.remove('text-2xl', 'sm:text-3xl');
      demoBalanceText.classList.add('text-lg', 'sm:text-xl');
      toggleBalanceBtn.textContent = 'MASK VALUE';
    } else {
      demoBalanceText.textContent = '••••••••••••';
      demoBalanceText.classList.remove('text-lg', 'sm:text-xl');
      demoBalanceText.classList.add('text-2xl', 'sm:text-3xl');
      toggleBalanceBtn.textContent = 'UNMASK DEMO';
    }
  });
</script>
