            </div>
            <span class="text-[10px] font-mono font-semibold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30">
              ENCRYPTED DIRECT CHANNEL
            </span>
          </div>

          <form id="direct-contact-form" class="space-y-4 font-mono text-xs">
            <!-- Honeypot Anti-Bot Field (Hidden from humans) -->
            <input 
              type="text" 
              name="_honey" 
              id="direct-honey" 
              style="display:none !important;" 
              tabindex="-1" 
              autocomplete="off" 
              aria-hidden="true" 
            />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Name Field -->
              <div class="space-y-1.5">
                <label for="direct-name" class="block font-bold text-slate-700 dark:text-slate-200 font-mono text-xs uppercase tracking-wider">YOUR NAME / ORGANIZATION *</label>
                <input 
                  type="text" 
                  id="direct-name" 
                  name="name"
                  required 
                  minlength="2"
                  maxlength="80"
                  placeholder="e.g. Sarah Jenkins (Enterprise Tech)"
                  class="w-full px-4 py-2.5 rounded-lg bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none transition-all font-mono text-xs shadow-xs"
                />
              </div>

              <!-- Email Field -->
              <div class="space-y-1.5">
                <label for="direct-email" class="block font-bold text-slate-700 dark:text-slate-200 font-mono text-xs uppercase tracking-wider">EMAIL ADDRESS *</label>
                <input 
                  type="email" 
                  id="direct-email" 
                  name="email"
                  required 
                  maxlength="100"
                  placeholder="e.g. sarah@enterprise.com"
                  class="w-full px-4 py-2.5 rounded-lg bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none transition-all font-mono text-xs shadow-xs"
                />
              </div>
            </div>

            <!-- Engagement Topic -->
            <div class="space-y-1.5">
              <label for="direct-topic" class="block font-bold text-slate-700 dark:text-slate-200 font-mono text-xs uppercase tracking-wider">ENGAGEMENT SCOPE</label>
              <select 
                id="direct-topic"
                name="scope"
                class="w-full px-4 py-2.5 rounded-lg bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none transition-all font-mono text-xs shadow-xs cursor-pointer"
              >
                <option value="Fintech Architecture Audit">Fintech Architecture Audit</option>
                <option value="PCI-DSS / Mobile Security Audit">PCI-DSS / Mobile Security Audit</option>
                <option value="Offline-First Engine Implementation">Offline-First Engine Implementation</option>
                <option value="Point of Sale (POS) Hardware & HAL Integration">Point of Sale (POS) Hardware & HAL Integration</option>
                <option value="Mobile AI & On-Device Neural Inference">Mobile AI & On-Device Neural Inference</option>
                <option value="Senior Leadership / Advisory">Senior Leadership / Advisory</option>
                <option value="General Technical Inquiry">General Technical Inquiry</option>
              </select>
            </div>

            <!-- Message Field -->
            <div class="space-y-1.5">
              <label for="direct-message" class="block font-bold text-slate-700 dark:text-slate-200 font-mono text-xs uppercase tracking-wider">PROJECT DETAILS / MESSAGE *</label>
              <textarea 
                id="direct-message" 
                name="message"
                required 
                minlength="15"
                maxlength="3000"
                rows="4" 
                placeholder="Outline your technical requirements, architecture scope, timeline, or objectives..."
                class="w-full px-4 py-2.5 rounded-lg bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 focus:outline-none transition-all font-mono text-xs shadow-xs"
              ></textarea>
              <div class="flex justify-between items-center text-[10px] text-slate-500 dark:text-slate-400 font-mono">
                <span>Minimum 15 characters</span>
                <span id="char-counter">0 / 3000</span>
              </div>
            </div>

            <!-- Form Status Message -->
            <div id="direct-status-msg" class="hidden p-3.5 rounded-lg text-xs font-bold border transition-all"></div>

            <!-- Submit Row -->
            <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-3">
              <button 
                type="submit" 
                id="direct-submit-btn"
                class="w-full sm:w-auto px-7 py-3 rounded-lg font-mono text-xs font-extrabold bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white shadow-lg shadow-emerald-600/30 hover:shadow-emerald-600/50 hover:-translate-y-0.5 active:scale-95 transition-all cursor-pointer flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                </svg>
                <span>SEND TRANSMISSION</span>
              </button>

              <span class="text-[11px] text-slate-600 dark:text-slate-400 text-center sm:text-right font-mono">
                Or direct: <a href="mailto:contact@moniruz.dev" class="text-emerald-600 dark:text-emerald-400 font-bold hover:underline">contact@moniruz.dev</a> • <a href="https://wa.me/8801721915013" target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 font-bold hover:underline">+8801721915013</a>
              </span>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
  // Operational Contact Form with Multi-Layer Anti-Abuse Shield
  const directForm = document.getElementById('direct-contact-form') as HTMLFormElement;
  const directStatus = document.getElementById('direct-status-msg');
  const directSubmitBtn = document.getElementById('direct-submit-btn');
  const honeyField = document.getElementById('direct-honey') as HTMLInputElement;
  const messageInput = document.getElementById('direct-message') as HTMLTextAreaElement;
  const charCounter = document.getElementById('char-counter');

  // Anti-Bot Timer: Track when the form was rendered on screen
  const formRenderTime = Date.now();

  // Character count indicator
  messageInput?.addEventListener('input', () => {
    if (charCounter) {
      charCounter.textContent = `${messageInput.value.length} / 3000`;
    }
  });

  const showStatus = (type: 'success' | 'error' | 'warning', text: string) => {
    if (!directStatus) return;
    directStatus.className = 'p-4 rounded-xl text-xs font-bold border font-mono transition-all';
    
    if (type === 'success') {
      directStatus.classList.add('bg-emerald-500/15', 'text-emerald-800', 'dark:text-emerald-300', 'border-emerald-500/40');
    } else if (type === 'warning') {
      directStatus.classList.add('bg-amber-500/15', 'text-amber-800', 'dark:text-amber-300', 'border-amber-500/40');
    } else {
      directStatus.classList.add('bg-red-500/15', 'text-red-800', 'dark:text-red-300', 'border-red-500/40');
    }
    
    directStatus.innerHTML = text;
    directStatus.classList.remove('hidden');
  };

  directForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!directStatus || !directSubmitBtn) return;

    // 1. Anti-Bot Honeypot Trap Check
    if (honeyField && honeyField.value.trim() !== '') {
      console.warn('Bot detected via honeypot trap.');
      showStatus('success', '✓ Transmission received.');
      directForm.reset();
      return;
    }

    // 2. Anti-Bot Speed Check (Reject automated submissions faster than 2.5 seconds)
    const elapsedSeconds = (Date.now() - formRenderTime) / 1000;
    if (elapsedSeconds < 2.5) {
      showStatus('warning', '⚠ Submission received unusually fast. Please review your message and submit again.');
      return;
    }

    // 3. Client-side Rate Limiting (Throttle: 1 message per 60s, max 5 per day)
    const STORAGE_KEY_LAST = 'portfolio_contact_last_ts';
    const STORAGE_KEY_COUNT = 'portfolio_contact_count';
    const now = Date.now();
    const lastSent = Number(localStorage.getItem(STORAGE_KEY_LAST) || 0);
    const cooldownRemaining = Math.ceil((60000 - (now - lastSent)) / 1000);

    if (now - lastSent < 60000 && cooldownRemaining > 0) {
      showStatus('warning', `⚠ Rate limit active. Please wait ${cooldownRemaining}s before sending another transmission, or reach out on <a href="https://wa.me/8801721915013" class="underline font-bold" target="_blank">WhatsApp</a>.`);
      return;
    }

    const todayStr = new Date().toISOString().slice(0, 10);
    const countData = JSON.parse(localStorage.getItem(STORAGE_KEY_COUNT) || '{"date":"","count":0}');
    if (countData.date === todayStr && countData.count >= 5) {
      showStatus('warning', '⚠ Daily transmission limit reached. Please contact directly via email (<a href="mailto:contact@moniruz.dev" class="underline font-bold">contact@moniruz.dev</a>) or <a href="https://wa.me/8801721915013" class="underline font-bold" target="_blank">WhatsApp</a>.');
      return;
    }

    // 4. Form Fields Extraction & Sanitization
    const nameInput = document.getElementById('direct-name') as HTMLInputElement;
    const emailInput = document.getElementById('direct-email') as HTMLInputElement;
    const topicInput = document.getElementById('direct-topic') as HTMLSelectElement;

    const name = nameInput.value.trim();
    const email = emailInput.value.trim();
    const scope = topicInput.value;
    const message = messageInput.value.trim();

    // Basic structure validation
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      showStatus('error', '⚠ Please provide a valid email address.');
      return;
    }

    if (message.length < 15) {
      showStatus('error', '⚠ Please provide at least 15 characters in your message to help understand your requirements.');
      return;
    }

    // 5. Button Lock & Sending State
    directSubmitBtn.setAttribute('disabled', 'true');
    const originalBtnContent = directSubmitBtn.innerHTML;
    directSubmitBtn.innerHTML = `
      <svg class="animate-spin w-4 h-4 mr-2" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>ENCRYPTING & DISPATCHING...</span>
    `;

    try {
      // 6. Direct Operational Dispatch via FormSubmit.co AJAX API
      const response = await fetch('https://formsubmit.co/ajax/contact@moniruz.dev', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          name: name,
          email: email,
          engagement_scope: scope,
          message: message,
          _subject: `[Portfolio Inquiry] ${scope} - ${name}`,
          _template: 'table',
          _captcha: 'false'
        })
      });

      const result = await response.json();

      if (response.ok || result.success === "true" || result.success === true) {
        showStatus('success', '✓ Transmission successfully delivered to Md Moniruzzaman! You will receive a response within 24 hours.');
        
        // Record rate limit timestamps
        localStorage.setItem(STORAGE_KEY_LAST, String(Date.now()));
        const newCount = (countData.date === todayStr ? countData.count : 0) + 1;
        localStorage.setItem(STORAGE_KEY_COUNT, JSON.stringify({ date: todayStr, count: newCount }));

        directForm.reset();
        if (charCounter) charCounter.textContent = '0 / 3000';
      } else {
        throw new Error(result.message || 'Dispatch service temporarily unavailable.');
      }
    } catch (err: any) {
      console.error('Contact dispatch error:', err);
      // Fallback assistance with prefilled mailto link
      const mailtoUrl = `mailto:contact@moniruz.dev?subject=${encodeURIComponent('[Inquiry] ' + scope)}&body=${encodeURIComponent('From: ' + name + ' (' + email + ')\n\n' + message)}`;
      showStatus('error', `⚠ Network dispatch timeout. Please <a href="${mailtoUrl}" class="underline font-bold text-white">click here to send via your email client directly</a> or message via <a href="https://wa.me/8801721915013" class="underline font-bold text-white" target="_blank">WhatsApp (+8801721915013)</a>.`);
    } finally {
      directSubmitBtn.removeAttribute('disabled');
      directSubmitBtn.innerHTML = originalBtnContent;
    }
  });
</script>
