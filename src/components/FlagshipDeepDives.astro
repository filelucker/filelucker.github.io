---
import { FLAGSHIP_PROJECTS } from '../data/portfolioData';
---

<div class="space-y-8">
  
  <!-- Section Title Header -->
  <div class="border-b border-[var(--border-color)] pb-4">
    <div class="flex items-center space-x-2 text-xs font-mono text-emerald-500 font-bold mb-1">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>PRODUCTION PLATFORMS & SYSTEM CASE STUDIES</span>
    </div>
    <h2 class="text-3xl font-extrabold text-[var(--text-primary)] font-mono">
      FLAGSHIP PRODUCTION PROJECTS
    </h2>
    <p class="text-sm text-[var(--text-muted)] font-mono mt-1">
      In-depth architectural analysis, verified production metrics, technical challenges, and live Play Store / App Store download channels.
    </p>
  </div>

  <!-- Deep Dive Project Cards List -->
  <div class="space-y-6">
    {FLAGSHIP_PROJECTS.map((project, index) => (
      <div class="terminal-card p-6 lg:p-8 space-y-6 relative group border border-[var(--border-color)] hover:border-emerald-500/30 transition-all">
        
        <!-- Header Row -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-[var(--border-color)]">
          <div>
            <div class="flex items-center space-x-3">
              <span class="text-xs font-mono font-bold text-emerald-500 px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/30">
                0{index + 1}. {project.category.toUpperCase()}
              </span>
              <span class="text-xs font-mono text-[var(--text-muted)]">SYSTEM ID: {project.id.toUpperCase()}</span>
            </div>
            <h3 class="text-2xl font-bold text-[var(--text-primary)] font-mono mt-2 group-hover:text-cyan-400 transition-colors">
              {project.title}
            </h3>
          </div>

          <div class="flex items-center space-x-2">
            <span class="px-3 py-1 rounded-full text-xs font-mono font-extrabold bg-cyan-500/10 text-cyan-400 border border-cyan-500/30">
              {project.badgeText}
            </span>
          </div>
        </div>

        <!-- Full Description & Metrics -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          
          <!-- Narrative & Accomplishments (7 Cols) -->
          <div class="lg:col-span-7 space-y-4">
            <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
              {project.fullDescription}
            </p>

            <div class="space-y-2">
              <h4 class="text-xs font-mono font-bold text-emerald-500 uppercase tracking-wide">
                Key Architectural Accomplishments:
              </h4>
              <ul class="space-y-2 font-mono text-xs text-[var(--text-secondary)]">
                {project.architectureHighlights.map((highlight) => (
                  <li class="flex items-start space-x-2">
                    <span class="text-emerald-500 font-bold mt-0.5">▸</span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Impact Metrics Grid (5 Cols) -->
          <div class="lg:col-span-5 flex flex-col justify-between space-y-4">
            <div class="p-4 rounded-xl glass-panel border border-[var(--border-color)] space-y-3">
              <h4 class="text-xs font-mono font-bold text-[var(--text-primary)] border-b border-[var(--border-color)] pb-2 flex justify-between">
                <span>VERIFIED IMPACT METRICS</span>
                <span class="text-emerald-500">PROD DATA</span>
              </h4>

              <div class="grid grid-cols-2 gap-3 font-mono">
                {project.impactMetrics.map((m) => (
                  <div class="p-2.5 rounded bg-[var(--bg-main)] border border-[var(--border-color)]">
                    <span class="text-[10px] text-[var(--text-muted)] block">{m.label.toUpperCase()}</span>
                    <span class="text-base font-extrabold text-[var(--text-primary)]">{m.value}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Tech Stack Tags -->
            <div>
              <div class="text-[11px] font-mono text-[var(--text-muted)] mb-2 uppercase">TECHNOLOGY ENGINES:</div>
              <div class="flex flex-wrap gap-1.5 font-mono text-xs">
                {project.tags.map((t) => (
                  <span class="px-2.5 py-1 rounded bg-[var(--bg-main)] text-[var(--text-primary)] border border-[var(--border-color)] font-semibold">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          </div>

        </div>

        <!-- Live App Store & Production Website Action Bar -->
        {project.appLinks && project.appLinks.length > 0 && (
          <div class="pt-4 border-t border-[var(--border-color)] flex flex-col sm:flex-row sm:items-center justify-between gap-3 font-mono">
            <span class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-wider flex items-center space-x-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Live Production Channels:</span>
            </span>

            <div class="flex flex-wrap items-center gap-2">
              {project.appLinks.map((app) => (
                <a 
                  href={app.url} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-[var(--bg-main)] text-[var(--text-primary)] border border-[var(--border-color)] hover:border-emerald-500 hover:text-emerald-400 hover:bg-[var(--bg-card-hover)] transition-all shadow-xs group/link"
                >
                  {/* Google Play Store Icon */}
                  {app.type === 'playstore' && (
                    <svg class="w-4 h-4 text-emerald-400 group-hover/link:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M3.609 1.814L13.792 12 3.61 22.186a2.008 2.008 0 0 1-.61-1.42V3.234c0-.54.225-1.047.61-1.42zM15.207 13.414l2.586 2.586-11.517 6.65 8.931-9.236zm0-2.828L6.276 1.35l11.517 6.65-2.586 2.586zm1.414 1.414l3.535 2.042c1.125.65 1.125 1.71 0 2.36l-3.535 2.041-2.122-2.121 2.122-2.322z"/>
                    </svg>
                  )}

                  {/* Apple App Store Icon */}
                  {app.type === 'appstore' && (
                    <svg class="w-4 h-4 text-sky-400 group-hover/link:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 0.92-2.87-.93.04-2.03.63-2.67 1.38-.56.65-.99 1.7-0.86 2.73 1.05.08 2-.49 2.61-1.24z"/>
                    </svg>
                  )}

                  {/* Live Website Icon */}
                  {app.type === 'website' && (
                    <svg class="w-4 h-4 text-cyan-400 group-hover/link:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                    </svg>
                  )}

                  {/* GitHub Repo Icon */}
                  {app.type === 'github' && (
                    <svg class="w-4 h-4 text-purple-400 group-hover/link:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                    </svg>
                  )}

                  {/* Direct APK Download Icon */}
                  {app.type === 'apk' && (
                    <svg class="w-4 h-4 text-emerald-400 group-hover/link:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                  )}

                  {/* Google Drive APK Icon */}
                  {app.type === 'drive' && (
                    <svg class="w-4 h-4 text-amber-400 group-hover/link:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M7.71 3.5L1.15 15l3.43 6 6.55-11.5L7.71 3.5zm3.72 6.5l3.43 6h7.99l-3.43-6h-7.99zm5.42-6.5l-3.43 6 4 6.99 6.55-11.5-7.12-.49z"/>
                    </svg>
                  )}

                  <span>{app.label}</span>
                  <svg class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover/link:text-emerald-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>
    ))}
  </div>


  <!-- Commercial Run-times, Hardware HAL & Government Utilities Box -->
  <div class="terminal-card p-6 lg:p-8 space-y-4 border border-[var(--border-color)]">
    <div class="flex justify-between items-center pb-4 border-b border-[var(--border-color)] font-mono">
      <div class="flex items-center space-x-2">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
        <h3 class="text-xl font-bold text-[var(--text-primary)]">Commercial Run-times, Hardware HAL & Government Utilities</h3>
      </div>
      <span class="text-xs text-[var(--text-muted)]">SPECIALIZED SDKs</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 font-mono text-xs">
      <div class="p-4 rounded-lg bg-[var(--bg-main)] border border-[var(--border-color)] space-y-2">
        <span class="text-cyan-400 font-bold text-sm block">Point-of-Sale (POS) HAL</span>
        <p class="text-[var(--text-muted)] text-[11px]">Serial port, USB OTG & Bluetooth printer driver stack enabling thermal receipt printing & barcode scanning across 45+ POS devices.</p>
        <span class="inline-block text-[10px] px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400">ESC/POS & C++ HAL</span>
      </div>

      <div class="p-4 rounded-lg bg-[var(--bg-main)] border border-[var(--border-color)] space-y-2">
        <span class="text-emerald-400 font-bold text-sm block">Mobile AI & Vision Runtime</span>
        <p class="text-[var(--text-muted)] text-[11px]">On-device INT8 LiteRT & ONNX execution with OpenCV image binarization for instant edge receipt OCR and facial liveness.</p>
        <span class="inline-block text-[10px] px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400">LiteRT / NPU delegate</span>
      </div>

      <div class="p-4 rounded-lg bg-[var(--bg-main)] border border-[var(--border-color)] space-y-2">
        <span class="text-indigo-400 font-bold text-sm block">BioRegister SDK (HAL)</span>
        <p class="text-[var(--text-muted)] text-[11px]">Hardware abstraction layer for Android optical fingerprint scanners used in national biometric verification.</p>
        <span class="inline-block text-[10px] px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-400">C++ Native NDK</span>
      </div>

      <div class="p-4 rounded-lg bg-[var(--bg-main)] border border-[var(--border-color)] space-y-2">
        <span class="text-amber-400 font-bold text-sm block">Utility Bill Pay Enclave</span>
        <p class="text-[var(--text-muted)] text-[11px]">Encrypted batch bill payment dispatcher handling national electricity and gas utility invoice settlements.</p>
        <span class="inline-block text-[10px] px-2 py-0.5 rounded bg-amber-500/10 text-amber-400">Kotlin Coroutines</span>
      </div>
    </div>
  </div>

</div>
